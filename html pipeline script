pipeline {
    agent any

    stages {
        stage('git code ') {
            steps {
                git branch: 'main', url: 'https://github.com/Rythamtribhuwan/html.git'
            }
        }
        stage('deploy'){
            steps{
                sh '''
                rm -rf /var/www/html/luxe-salon
                mkdir -p /var/www/html/luxe-salon
                cp -r ./about.html ./Contact.html ./index.html ./README.md /var/www/html/luxe-salon/
                '''
            }
        }
    }
}
